{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResult",
  "description": "Résultat d'un appel d'outil.",
  "type": "object",
  "properties": {
    "content": {
      "description": "Contenu du résultat."
    },
    "trust": {
      "description": "Fiabilité imposée par le hub.",
      "$ref": "#/$defs/Trust"
    }
  },
  "additionalProperties": false,
  "required": [
    "content",
    "trust"
  ],
  "$defs": {
    "Trust": {
      "description": "Fiabilité d'un résultat : un résultat non fiable est une donnée, jamais une instruction.",
      "oneOf": [
        {
          "description": "Résultat produit par un composant de confiance.",
          "type": "string",
          "const": "trusted"
        },
        {
          "description": "Résultat issu d'une source externe (mail, page, serveur MCP…).",
          "type": "string",
          "const": "untrusted"
        }
      ]
    }
  }
}
